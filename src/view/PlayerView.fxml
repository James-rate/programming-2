<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<HBox fx:controller="controller.PlayerController" xmlns="http://javafx.com/javafx"
      stylesheets="@/view/style.css"
      xmlns:fx="http://javafx.com/fxml" spacing="20" alignment="TOP_CENTER" prefWidth="780" prefHeight="260" >
    <VBox>
        <TableView fx:id="handTv" prefWidth="280" prefHeight="200">
            <placeholder>
                <Label text="Empty"/>
            </placeholder>
            <columns>
                <TableColumn text="Name" prefWidth="70">
                    <cellValueFactory><PropertyValueFactory property="name"/> </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="attackClm" text="Attack" prefWidth="70"/>
                <TableColumn fx:id="styleClm" text="Style" prefWidth="70"/>
                <TableColumn fx:id="healthClm" text="Health" prefWidth="70"/>
            </columns>
        </TableView>
        <Button fx:id="selectBtn" text="Select" onAction="#handleselect" prefWidth="280" prefHeight="30"/>
    </VBox>
    <VBox>
        <ListView fx:id="temphandLv" prefWidth="280" prefHeight="200">
          <placeholder>
              <Label text="Empty"/>
          </placeholder>
        </ListView>
        <Button fx:id="placeBtn" text="Place" onAction="#handleplace" prefWidth="280" prefHeight="30"/>
    </VBox>
        <ImageView fx:id="playerCardView" fitWidth="150" fitHeight="250" preserveRatio="true">
            <Image url="/view/image/cards/empty.png"/>
        </ImageView>
</HBox>
